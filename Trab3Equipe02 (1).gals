#Options
GenerateScanner = true
GenerateParser = true
Language = Java
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
ScannerCaseSensitive = true
ScannerTable = Compact
Input = Stream
Parser = LL
#RegularDefinitions
num:[0-9]
letra:[a-z]
rest:(_{num}+)
percent:(%x)
exceto:[^\n\"\\%]|{percent}
linha: #[^\n]*
bloco: \{\n[^\{\}]*\n\}

#Tokens
//identificador
identificador:! ({letra})({rest}*{letra}*)*

//cte_int :!
cte_int:! ({num})+

//cte_float :!
cte_float:! ({num})+\.({num})+

//cte_char :!
cte_char:! \\(n|s|t)

//cte_string :!
cte_string:! \"{exceto}* \"

//comentarios: reconhecer e ignorar
:!{linha}

//comentario: reconhecer ignorar bloco
:!{bloco}

// caracteres de formatação: reconhecer e ignorar
:[\n\s\t]

// palavras reservadas: enunciado pt2 - ask bool char define end elif else false float
//if int main repeat string tell true until while

pr_ask = identificador: "ask"
pr_bool = identificador: "bool"
pr_char = identificador: "char"
pr_define = identificador: "define"
pr_end = identificador: "end"
pr_elif = identificador: "elif"
pr_else = identificador: "else"
pr_false = identificador: "false"
pr_float = identificador: "float"
pr_if = identificador: "if"
pr_int = identificador: "int"
pr_main = identificador: "main"
pr_repeat = identificador: "repeat"
pr_string = identificador: "string"
pr_tell = identificador: "tell"
pr_true = identificador: "true"
pr_until = identificador: "until"
pr_while = identificador: "while"



// simbolos especiais: enunciado pt2 - && || !    : ; , = <- ( ) && || ! == != < <= > >=
//+ - * / ^

 "&&"
 "||"
 "!"
 ":"
 ";"
 ","
 "="
 "<-"
 "("
")"
 "=="
 "!="
 "<"
 "<="
 ">"
 ">="
 "+"
 "-"
 "*"
 "/"
 "^"



#NonTerminals
<forma_geral_do_programa>

<lista_instrucoes>
<lista_instrucoes1>

<declaracao_var_opc>

<instrucao>

<declaracao_var>

<tipo>

<lista_id>
<lista_id1>

<declaracao_var_loop>
<declaracao_var_loop1>

<comando_atribuicao>
<comando_atribuicao1>

<entrada_dados>

<lista_entrada>
<lista_entrada1>

<cte_string_opc>

<saida_dados>

<lista_expressao>
<lista_expressao1>

<comando_selecao>

<lista_instrucoes_elif>

<lista_instrucoes_else>

<comando_repeticao>
<comando_repeticao1>

<expressao>

<termo_logico>

<expressao_>

<relacional>

<relacional_>

<aritmetica>

<aritmetica_>

<operador_relacional>

<termo_aritmetico>

<termo_aritmetico_>

<fator>

<fator_>

<elemento>
#Grammar
//Alunos: Gabriel Tormena Vargas, Gustavo Luchini, Emanuel Sergio Girardi

<forma_geral_do_programa> ::= pr_main #20 <declaracao_var_opc> <lista_instrucoes> pr_end #21 ;

//<lista_instrucoes> ::= <instrucao> ";" | <instrucao> ";" <lista_instrucoes> ;
<lista_instrucoes> ::= <instrucao> ";" <lista_instrucoes1> ;
<lista_instrucoes1> ::= î | <lista_instrucoes> ;

<declaracao_var_opc> ::= <declaracao_var> | î ;

<instrucao> ::= <comando_repeticao> | <entrada_dados> | <comando_selecao> | <comando_atribuicao> | <saida_dados> ;


<declaracao_var> ::= pr_define <declaracao_var_loop> ;

<tipo> ::= pr_bool | pr_char | pr_int | pr_float | pr_string ;

//<lista_id> ::= identificador | identificador "," <lista_id> ;
<lista_id> ::= identificador #24 <lista_id1> ;
<lista_id1> ::= î | "," <lista_id> ;

//<declaracao_var_loop> ::= <tipo> ":" <lista_id> ";"  | <tipo> ":" <lista_id> ";" <declaracao_var_loop> ;
<declaracao_var_loop> ::= <tipo> #22 ":" <lista_id> #23 ";" <declaracao_var_loop1> ;
<declaracao_var_loop1> ::= î | <declaracao_var_loop> ;

//<comando_atribuicao> ::= <lista_id> "=" <expressao> | <lista_id> "<-" <expressao> ;
<comando_atribuicao> ::= <lista_id> <comando_atribuicao1> ;
<comando_atribuicao1> ::= "=" <expressao> #25 | "<-" <expressao> #25 ;

<entrada_dados> ::= pr_ask "(" <lista_entrada> ")" ;

//<lista_entrada> ::= <cte_string_opc> identificador | <cte_string_opc> identificador "," <lista_entrada> ;
<lista_entrada> ::=  <cte_string_opc> identificador #26 <lista_entrada1> ;
<lista_entrada1> ::= î | "," <lista_entrada> ;

<cte_string_opc> ::= cte_string #19 #14 "," | î ;


<saida_dados> ::= pr_tell "(" <lista_expressao> ")" ;

//<lista_expressao> ::= <expressao> | <expressao> "," <lista_expressao> ;
<lista_expressao> ::= <expressao> #14 <lista_expressao1> ;
<lista_expressao1> ::= î | "," <lista_expressao> ;

<comando_selecao> ::= pr_if <expressao> #27 <lista_instrucoes> <lista_instrucoes_elif> #28 <lista_instrucoes_else> pr_end #29 ;
<lista_instrucoes_elif> ::= #28 pr_elif <expressao> #30 <lista_instrucoes> <lista_instrucoes_elif> | î ;
<lista_instrucoes_else> ::= pr_else <lista_instrucoes> | î ;


//<comando_repeticao> ::= pr_repeat <lista_instrucoes> pr_while <expressao> | pr_repeat <lista_instrucoes> pr_until <expressao> ;
<comando_repeticao> ::=  pr_repeat #32 <lista_instrucoes> <comando_repeticao1> ;
<comando_repeticao1> ::= pr_while <expressao> #33 | pr_until <expressao> #34 ;


<expressao> ::= <termo_logico> <expressao_> ;
<expressao_> ::= î | "&&" <termo_logico> #15 <expressao_> | "||" <termo_logico> #16 <expressao_> ;
<termo_logico> ::= <relacional> | pr_true #11 | pr_false #12 | "!" <termo_logico> #13 ;
<relacional> ::= <aritmetica> <relacional_> ;
<relacional_> ::= î | <operador_relacional> #9 <aritmetica> #10 ;
<operador_relacional>::= "==" | "!=" | "<" | "<=" | ">" |">=" ;
<aritmetica> ::= <termo_aritmetico> <aritmetica_> ;
<aritmetica_> ::= î | "+" <termo_aritmetico> #1 <aritmetica_> |
 "-" <termo_aritmetico> #2 <aritmetica_> ;
<termo_aritmetico> ::= <fator> <termo_aritmetico_> ;
<termo_aritmetico_> ::= î | "*" <fator> #3 <termo_aritmetico_> | "/" <fator> #4 <termo_aritmetico_> ;
<fator> ::= <elemento> <fator_> ;
<fator_> ::= î | "^" <elemento> #17  <fator_> ;
<elemento> ::= identificador #31 |
 cte_int #5 |
 cte_float #6 |
 cte_char #18 |
 cte_string #19 |
 "(" <expressao> ")" |
 "+" <elemento> #7 |
 "-" <elemento> #8 ; 

